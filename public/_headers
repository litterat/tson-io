  Link: </llms.txt>; rel="alternate"; type="text/plain"; title="llms.txt — machine-readable site index"

# Schema sources and fixtures for every revision, current and retained.
# One placeholder plus one splat is the most Cloudflare allows in a rule,
# so this covers /2026/{revision}/m/… without a per-revision entry.
/2026/:revision/m/*
  Content-Type: text/plain; charset=utf-8

# Skill bundles for every revision. A .skill file is a zip; served as one so a
# browser downloads it rather than guessing. Same placeholder-plus-splat shape
# as the m/* rule above, so it covers every revision without a per-revision entry.
/2026/:revision/skills/*
  Content-Type: application/zip
  Content-Disposition: attachment

/raw/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8

/research-llms.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
