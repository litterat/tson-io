# Schema sources and fixtures for every revision, current and retained.
# One placeholder plus one splat is the most Cloudflare allows in a rule,
# so this covers /2026/{revision}/m/… without a per-revision entry.
/2026/:revision/m/*
  Content-Type: text/plain; charset=utf-8

/raw/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8

/research-llms.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
