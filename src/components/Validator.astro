---
/**
 * The live validator: a TSON schema resolved, linked and compiled in the visitor's browser, and a
 * document validated against it. Every fault in one pass — the claim the rest of the page makes in
 * prose, made here by the validator itself.
 *
 * Ported from `examples/web-demo` in the TypeScript implementation
 * (github.com/litterat/ltr8-io-tson-typescript), which is where the scenarios and the diagnostics
 * rendering are maintained. Nothing is fetched: `@ltr8/tson/stdlib` carries meta-kernel, meta.tn
 * and core.tn as embedded text, so the whole ladder resolves client-side.
 */
---

<div id="tson-demo">
  <div class="scenarios">
    <span class="label">Try it here!</span>
    <span id="td-scenarios" class="chips"></span>
  </div>

  <!-- The pair, editable: data left, schema right — the hero visual this replaces. -->
  <div class="panes main-panes">
    <div class="pane">
      <div class="pane-head">
        <span class="pane-title">TSON Data</span>
        <span class="pane-note">
          read against
          <input id="td-root" class="root-input" aria-label="schema entry the root value reads against" />
        </span>
      </div>
      <div class="editor">
        <div class="gutter" id="td-gutter" aria-hidden="true"></div>
        <textarea id="td-data" spellcheck="false" aria-label="TSON document"></textarea>
      </div>
    </div>

    <!-- The schema shares its pane with the diagnostics: two tabs, schema first. A fault switches
         to the diagnostics itself, so the payoff never waits on a click. -->
    <div class="pane">
      <div class="pane-head tabbed">
        <span class="tabstrip" role="tablist" aria-label="schema or diagnostics">
          <button type="button" class="tab" id="td-tab-schema" role="tab" aria-selected="true"
            aria-controls="td-panel-schema">TSON Schema</button>
          <button type="button" class="tab" id="td-tab-diags" role="tab" aria-selected="false"
            aria-controls="td-panel-diags">Diagnostics <span class="badge" id="td-badge">0</span></button>
        </span>
        <span class="pane-note" id="td-note">compiled in your browser</span>
      </div>
      <div class="editor no-gutter" id="td-panel-schema" role="tabpanel" aria-labelledby="td-tab-schema">
        <textarea id="td-schema" spellcheck="false" aria-label="TSON schema"></textarea>
      </div>
      <div class="diag-panel" id="td-panel-diags" role="tabpanel" aria-labelledby="td-tab-diags" hidden>
        <div class="verdict ok" id="td-verdict"><span class="dot"></span><span>…</span></div>
        <ul class="diags" id="td-diags"></ul>
      </div>
    </div>
  </div>

</div>

<style is:global>
  /* Scoped under #tson-demo: the diagnostics list is built as HTML strings at runtime, which
     Astro's scoped styles never reach (they tag markup at build time). */
  #tson-demo {
    --td-editor-size: 13px;
    --td-editor-leading: 22px;
  }

  #tson-demo .scenarios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 0 0 0.75rem;
  }
  #tson-demo .chips { display: contents; }
  #tson-demo .scenarios .label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    /* the same red the gutter marks a faulting line with */
    color: var(--color-red-700);
    margin-right: 0.25rem;
  }
  /* The chips carry their own verdict: green is the document that conforms, yellow the ones that
     do not. Selecting one saturates its own hue rather than going uniformly dark, so the row keeps
     saying which is which. */
  #tson-demo .chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    padding: 0.3rem 0.75rem;
    background: var(--color-yellow-100);
    color: var(--color-yellow-900);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  #tson-demo .chip:hover { border-color: var(--color-yellow-400); }
  #tson-demo .chip[aria-pressed='true'] {
    background: var(--color-amber-400);
    color: var(--color-gray-900);
  }
  #tson-demo .chip.ok { background: var(--color-green-100); color: var(--color-green-900); }
  #tson-demo .chip.ok:hover { border-color: var(--color-green-400); }
  #tson-demo .chip.ok[aria-pressed='true'] { background: var(--color-green-600); color: #fff; }
  @media (prefers-reduced-motion: reduce) {
    #tson-demo .chip { transition: none; }
  }

  #tson-demo .panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 60rem) {
    #tson-demo .panes { grid-template-columns: 1fr; }
  }
  #tson-demo .pane {
    border: 1px solid var(--color-gray-200);
    border-radius: 0.375rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* Centred, not baseline-aligned: the right pane's head holds tab buttons rather than plain text,
     and on a baseline its note sat 9px above the left pane's. Both notes now share a line. */
  #tson-demo .pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--color-gray-200);
    background: var(--color-gray-50);
    min-height: 2.625rem;
  }
  #tson-demo .pane-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-800);
  }
  #tson-demo .pane-note { font-size: 0.75rem; color: var(--color-gray-500); }

  /* Both editors are one height, sized to the schema — the taller of the two — so the pair reads
     as a matched set the way the static hero panes it replaces did. */
  #tson-demo .main-panes .pane { height: 27.5rem; }
  #tson-demo .pane-title.schema { color: var(--color-teal-700); }

  /* `grid-template-rows` is load-bearing: without it the row auto-sizes to the textarea's content,
     so a long document made the textarea taller than the pane and the pane clipped it with nothing
     to scroll. Bounding the row lets the textarea's own `overflow: auto` do the scrolling. */
  #tson-demo .editor {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: minmax(0, 1fr);
    background: #fff;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  #tson-demo .editor.no-gutter { grid-template-columns: 1fr; }
  #tson-demo .gutter {
    padding: 0.75rem 0.55rem 0.75rem 0.75rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--td-editor-size);
    line-height: var(--td-editor-leading);
    color: var(--color-gray-300);
    background: var(--color-gray-50);
    border-right: 1px solid var(--color-gray-200);
    user-select: none;
    white-space: pre;
    tab-size: 2;
    overflow: hidden;
  }
  #tson-demo .gutter .bad { color: var(--color-red-700); font-weight: 700; }
  #tson-demo .editor textarea {
    font-family: var(--font-mono);
    font-size: var(--td-editor-size);
    line-height: var(--td-editor-leading);
    padding: 0.75rem 0.9rem;
    border: 0;
    resize: vertical;
    outline: none;
    color: var(--color-gray-900);
    background: transparent;
    height: 100%;
    tab-size: 2;
    white-space: pre;
    overflow: auto;
  }
  #tson-demo .editor textarea:focus { background: var(--color-teal-50); }

  #tson-demo .verdict {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--color-gray-200);
    font-size: 0.875rem;
  }
  #tson-demo .dot { width: 0.5rem; height: 0.5rem; border-radius: 9999px; flex: none; }
  #tson-demo .verdict.ok { background: var(--color-teal-50); color: var(--color-teal-950); }
  #tson-demo .verdict.ok .dot { background: var(--color-teal-600); }
  #tson-demo .verdict.bad { background: var(--color-red-100); color: var(--color-gray-900); }
  #tson-demo .verdict.bad .dot { background: var(--color-red-700); }
  #tson-demo .verdict.warn { background: var(--color-amber-50); color: var(--color-amber-900); }
  #tson-demo .verdict.warn .dot { background: var(--color-amber-700); }
  #tson-demo .verdict .count { font-family: var(--font-mono); font-weight: 700; }
  #tson-demo .verdict .timing {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }

  #tson-demo .diags {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }
  #tson-demo .diags li { border-bottom: 1px solid var(--color-gray-100); }
  #tson-demo .diags button {
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    font: inherit;
    display: block;
  }
  #tson-demo .diags button:hover { background: var(--color-gray-50); }
  #tson-demo .diag-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }
  #tson-demo .code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    border-radius: 9999px;
    padding: 0.1rem 0.5rem;
    background: var(--color-red-100);
    color: var(--color-red-700);
    white-space: nowrap;
  }
  #tson-demo .code.gap { background: var(--color-amber-50); color: var(--color-amber-900); }
  #tson-demo .at { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-gray-500); }
  #tson-demo .msg { font-size: 0.875rem; color: var(--color-gray-800); }
  #tson-demo .detail {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gray-600);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  #tson-demo .detail .k { color: var(--color-gray-400); }
  #tson-demo .diags button.fix {
    display: inline-block;
    width: auto;
    margin: 0 0.9rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 9999px;
    padding: 0.3rem 0.7rem;
    background: var(--color-teal-700);
    color: #fff;
    border: 0;
    cursor: pointer;
  }
  #tson-demo .diags button.fix:hover { background: var(--color-teal-800); }
  /* Digests and long tokens break rather than widening the pane. */
  #tson-demo .detail span { overflow-wrap: anywhere; }
  #tson-demo .empty {
    padding: 2rem 0.9rem;
    text-align: center;
    color: var(--color-gray-500);
    font-size: 0.875rem;
  }

  /* The diagnostics band: full width under both panes, and it scrolls rather than running the
     section off the page when a scenario plants ten faults. */
  /* ── the schema/diagnostics tab strip ─────────────────────────────────── */
  #tson-demo .pane-head.tabbed { padding: 0 0.9rem 0 0; }
  #tson-demo .tabstrip { display: flex; align-self: stretch; }
  #tson-demo .tab {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-500);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  #tson-demo .tab:hover { color: var(--color-gray-800); }
  #tson-demo .tab[aria-selected='true'] {
    color: var(--color-teal-700);
    border-bottom-color: var(--color-teal-600);
    background: #fff;
  }
  #tson-demo .badge {
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    border-radius: 9999px;
    padding: 0.15rem 0.4rem;
    background: var(--color-gray-200);
    color: var(--color-gray-600);
  }
  #tson-demo .badge.bad { background: var(--color-red-100); color: var(--color-red-700); }
  #tson-demo .badge.warn { background: var(--color-amber-50); color: var(--color-amber-900); }
  #tson-demo .badge.ok { background: var(--color-teal-100); color: var(--color-teal-800); }

  #tson-demo .diag-panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    background: #fff;
  }
  #tson-demo .diag-panel[hidden] { display: none; }
  #tson-demo .diag-panel .diags { flex: 1; min-height: 0; }

  #tson-demo .root-input {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    width: 7.5rem;
    margin-left: 0.4rem;
    border: 1px solid var(--color-gray-300);
    border-radius: 0.25rem;
    padding: 0.05rem 0.35rem;
    color: var(--color-gray-800);
  }
  #tson-demo .root-input:focus { outline: 2px solid var(--color-teal-300); outline-offset: -1px; }
</style>

<script>
  import { classifyDocument, parse, validate } from '@ltr8/tson';
  import { CORE_TN, META_TN, standardLibrary } from '@ltr8/tson/stdlib';
  import {
    canonicalizeIdentity,
    declaredSha256,
    sha256Hex,
    withSha256Pin,
  } from '@ltr8/tson/identity';
  import type { CompiledSchema, Diagnostic, Document } from '@ltr8/tson';

  interface SchemaSpec {
    id: string;
    body: string;
  }

  const PEOPLE_BODY = `@doc:"The demo schema: an employee record."
{
  @doc:"A person on the payroll."
  employee => {
    id:        uuid
    name:      non_empty_text
    age:       uint8
    email:     email
    started:   date
    active:    boolean
    tags:      [non_empty_text]?
  }
}
`;

  const OBSERVATORY_BODY = `@doc:"A tour of the schema language: atom refinements, enums, templates, field groups, maps, sets, tuples, composition, refinement, subtraction and guarded recursion."
{
  @doc:"Three letters, a dash, three digits."
  designator => !text ^ { pattern: "^[A-Z]{3}-[0-9]{3}$" }

  @doc:"Metres above the reference ellipsoid."
  altitude_m => !integer ^ { min: -500  max: 9000 }

  channel => !integer ^ { min: 1  max: 64  multiple_of: 1 }

  band => !enum [RADIO INFRARED OPTICAL ULTRAVIOLET XRAY GAMMA]

  status => !enum [PLANNED ACTIVE DEGRADED RETIRED]

  @doc:"A type parameter, used at an element position."
  bag => <T> [T]

  @doc:"Two type parameters."
  pair => <A, B> { first: A  second: B }

  @doc:"A type parameter and a value parameter: a fixed-length vector."
  vector => <T, N> [T; N]

  @doc:"Partial application re-declares the open parameter."
  index_of => <V> {designator => V}

  @doc:"A set: unordered, unique. Applied by constructor, since set has no sugar."
  partner_set => !set { element_type: non_empty_text }

  coordinate => [number, number]

  reading_window => [datetime, datetime]

  sample_run => vector<number, 4>

  short_label => !text ^ { min_length: 1  max_length: 12 }

  @doc:"Guarded recursion: the child list is optional, so the type has finite members."
  subsystem => {
    name:      non_empty_text
    state:     status ~ ACTIVE
    children:  [subsystem]?
  }

  @doc:"Mixin contributing provenance to anything that composes it."
  provenance => {
    recorded_by:  non_empty_text
    recorded_at:  datetime
  }

  identified => {
    id:    designator
    name:  non_empty_text
  }

  @doc:"A labelled sum in record clothing: exactly one member present."
  cadence => {
    ( continuous:  boolean
    | every_n_sec: positive_integer
    | on_trigger:  non_empty_text )
  }

  @doc:"An optional group: at most one bound may be stated."
  exposure => {
    band:     band
    ( max_seconds: positive_integer | max_frames: positive_integer )?
  }

  instrument => identified & provenance & {
    @doc:"REQUIRED - must be supplied."
    band:        band
    @doc:"REQUIRED_DEFAULT - injected when omitted."
    channel:     channel ~ 1
    @doc:"REQUIRED_FIXED - immutable from here down."
    schema_kind: text = "instrument"
    @doc:"OPTIONAL - may be absent."
    serial:      short_label?
    @doc:"OPTIONAL_FIXED - if present, must be this value."
    calibrated:  boolean? = true
    @doc:"OPTIONAL_FIXED with no value - the field is forbidden to carry one."
    retired_on:  date? = _

    aperture_mm: positive_integer
    cadence:     cadence
    exposure:    exposure
    targets:     [designator; 1..8]
    tuning:      {non_empty_text => number; ..16}
    samples:     sample_run
    notes:       bag<non_empty_text>?
  }

  @doc:"Refinement pins fields of an existing record."
  radio_instrument => instrument ^ {
    band:        = RADIO
    aperture_mm: ~ 25000
  }

  @doc:"Subtraction removes fields from an existing record."
  instrument_public => instrument - { recorded_by, serial }

  @doc:"A user-defined valueless annotation: presence is the information. Written bare in data."
  @annotation
  critical => void

  @doc:"A user-defined text annotation. Written @operator:\\"...\\" in data."
  @annotation
  operator => text

  @doc:"A user-defined record annotation: the annotation value is a whole record."
  @annotation
  calibration => {
    by:         non_empty_text
    on:         date
    drift_ppm:  number
    verified:   boolean ~ false
  }

  @doc:"Built-in atoms from core, each parsed and constrained by its own grammar."
  telemetry => {
    stream_id:  uuid
    endpoint:   uri
    host:       ipv4
    heartbeat:  duration
    checksum:   base64
    window_utc: time
    @deprecated:"superseded by endpoint"
    legacy_url: uri?
    @since:"2026-34"
    mac_addr:   mac?
  }

  @doc:"An observatory: the document root."
  observatory => identified & provenance & {
    established:   date
    site:          coordinate
    altitude:      altitude_m
    status:        status ~ ACTIVE
    tree:          subsystem
    window:        reading_window
    instruments:   [instrument; 1..]
    catalog:       index_of<non_empty_text>
    contacts:      {non_empty_text => email}
    readings:      {non_empty_text => number?}
    partners:      partner_set?
    sparse_crew:   [non_empty_text?; 3]
    highlight:     pair<designator, non_empty_text>?
    published:     instrument_public?
    radio:         radio_instrument?
    telemetry:     telemetry
  }
}
`;

  const PEOPLE: SchemaSpec = { id: 'https://example.com/people.tn', body: PEOPLE_BODY };
  const OBSERVATORY: SchemaSpec = {
    id: 'https://tson.io/2026/34/examples/observatory.tn',
    body: OBSERVATORY_BODY,
  };

  interface Scenario {
    id: string;
    label: string;
    root: string;
    data: string;
    /** The document is expected to conform — colours the chip green rather than yellow. */
    ok?: boolean;
    /** Also restores the shipped schema, making this chip a full reset to a conforming pair. */
    resetsSchema?: boolean;
    /** The schema this example is written against; the people schema when omitted. */
    schema?: SchemaSpec;
    /** Accessible name, for a chip whose visible label is an emoji and names nothing on its own. */
    aria?: string;
  }

  const SCENARIOS: Scenario[] = [
    {
      id: 'valid',
      label: 'valid',
      root: 'employee',
      ok: true,
      resetsSchema: true,
      data: `!!schema:"https://example.com/people.tn?sha256=__PIN__"
!employee {
  id:      "f81d4fae-7dec-11d0-a765-00a0c91e6bf6"
  name:    "Ada Lovelace"
  age:     36
  email:   "ada@example.com"
  started: 2026-01-15
  active:  true
  tags:    ["founder" "mathematician"]
}
`,
    },
    {
      id: 'planted',
      label: 'ten planted errors',
      root: 'employee',
      data: `!!schema:"https://example.com/people.tn?sha256=__PIN__"
!employee {
  id:        "not-a-uuid"
  name:      ""
  age:       300
  email:     "ada@@example.com"
  started:   2026-13-45
  active:    yes
  tags:      { first: "founder" }
  nickname:  "Countess"
  salary:    100000
  id:        "f81d4fae-7dec-11d0-a765-00a0c91e6bf6"
}
`,
    },
    {
      // One mistyped field name, two diagnostics: the field nobody declared, and the required one
      // it was meant to be. A tolerant reader would have dropped the value silently.
      id: 'typo',
      label: 'one typo',
      root: 'employee',
      data: `!!schema:"https://example.com/people.tn?sha256=__PIN__"
!employee {
  id:      "f81d4fae-7dec-11d0-a765-00a0c91e6bf6"
  name:    "Ada Lovelace"
  age:     36
  emai:    "ada@example.com"
  started: 2026-01-15
  active:  true
}
`,
    },
    {
      id: 'missing',
      label: 'missing fields',
      root: 'employee',
      data: `!!schema:"https://example.com/people.tn?sha256=__PIN__"
!employee {
  name: "Grace Hopper"
  age:  45
}
`,
    },
    {
      id: 'syntax',
      label: 'malformed syntax',
      root: 'employee',
      data: `!!schema:"https://example.com/people.tn?sha256=__PIN__"
!employee {
  id:   "f81d4fae-7dec-11d0-a765-00a0c91e6bf6"
  name: "Unclosed record
  age:  36
`,
    },
    {
      id: 'schemaless',
      label: 'no schema (Class 1)',
      root: '',
      data: `{
  reading:  42
  when:     !datetime "2026-08-28T05:14:00Z"
  where:    !ipv4 "10.0.0.1"
  who:      !nonesuch "unknown to the built-in vocabulary"
  nested:   { a: [1 2 3]  b: { c: _ } }
}
`,
    },
    {
      // The whole schema language in one document: atom refinements, enums, templates and
      // partial application, field groups, maps, sets, tuples, composition, refinement,
      // subtraction and guarded recursion — and all five field states, labelled in place.
      id: 'observatory',
      label: '🔭',
      aria: 'observatory — the whole schema language in one document',
      root: 'observatory',
      ok: true,
      schema: OBSERVATORY,
      data: `!!schema:"https://tson.io/2026/34/examples/observatory.tn?sha256=__PIN__"

!observatory {
  id:          "MKA-001"
  name:        "Mauna Kea Array"
  recorded_by: "D. Halley"
  recorded_at: "2026-08-28T04:12:00Z"
  established: 1968-07-20
  site:        [19.8207 -155.4681]
  altitude:    4207
  status:      ACTIVE

  tree: {
    name:  "array"
    state: ACTIVE
    children: [
      { name: "dish-a"  state: ACTIVE }
      {
        name:  "dish-b"
        state: DEGRADED
