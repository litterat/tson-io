  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const encoder = new TextEncoder();

  /**
   * The schema, headed by the full pinned chain. `!!meta` and `!!import` take their references
   * from the stdlib documents themselves rather than from hardcoded hex, so they are exactly the
   * identities the registry is keyed by and cannot drift from the schemas actually shipped.
   *
   * `selfPin` goes on `!!id`, and stamping it does not change the digest it states: §7.3 hashes
   * from the second line on, precisely so a document can name its own content.
   */
  function buildSchema(spec: SchemaSpec, selfPin: string | null): string {
    const metaId = classifyDocument(encoder.encode(META_TN)).id ?? '';
    const coreId = classifyDocument(encoder.encode(CORE_TN)).id ?? '';
    const id = selfPin ? `${spec.id}?sha256=${selfPin}` : spec.id;
    return `!!id:"${id}"\n!!meta:"${metaId}"\n!!import:"${coreId}"\n${spec.body}`;
  }

  /** `spec` carrying its own digest on the `!!id`, the line §7.3 excludes from that digest. */
  async function pinnedSchema(spec: SchemaSpec): Promise<string> {
    try {
      return buildSchema(spec, await sha256Hex(encoder.encode(buildSchema(spec, null))));
    } catch {
      return buildSchema(spec, null); // no hash boundary; leave it unpinned
    }
  }

  const dataEl = $<HTMLTextAreaElement>('td-data');
  const schemaEl = $<HTMLTextAreaElement>('td-schema');
  const rootEl = $<HTMLInputElement>('td-root');
  const gutterEl = $<HTMLElement>('td-gutter');
  const diagsEl = $<HTMLElement>('td-diags');
  const verdictEl = $<HTMLElement>('td-verdict');
  const chipsEl = $<HTMLElement>('td-scenarios');
  const tabSchema = $<HTMLButtonElement>('td-tab-schema');
  const tabDiags = $<HTMLButtonElement>('td-tab-diags');
  const panelSchema = $<HTMLElement>('td-panel-schema');
  const panelDiags = $<HTMLElement>('td-panel-diags');
  const badgeEl = $<HTMLElement>('td-badge');
  const noteEl = $<HTMLElement>('td-note');

  /** Set once the reader picks a tab by hand, so a later fault never yanks the pane out from under
   *  them. Cleared when they load a scenario, which is a fresh start. */
  let tabPinned = false;

  /** The schema pane's note. The digest itself lives on the `!!id` line, not out here. */
  let schemaBroken = false;

  function renderNote() {
    if (!noteEl || !panelDiags) return;
    if (!panelDiags.hidden) {
      noteEl.textContent = 'click one to jump to it';
      return;
    }
    noteEl.textContent = schemaBroken
      ? 'schema error — see Diagnostics'
      : 'compiled in your browser';
  }

  function showTab(which: 'schema' | 'diags') {
    if (!tabSchema || !tabDiags || !panelSchema || !panelDiags) return;
    const diags = which === 'diags';
    tabSchema.setAttribute('aria-selected', String(!diags));
    tabDiags.setAttribute('aria-selected', String(diags));
    panelSchema.hidden = diags;
    panelDiags.hidden = !diags;
    renderNote();
  }

  /**
   * The schema's own content hash, recomputed on every edit — the pin the `!!id` of a published
   * schema carries (§2.2.1), computed here rather than quoted.
   *
   * §7.3 hashes from the *second* line on, which is why editing the `!!id` line leaves this
   * unchanged while editing anything below it does not: a document's identity cannot be part of
   * what that identity pins. `sha256Hex` throws when the first line has no terminator, since then
   * there is no well-defined boundary to start at.
   */
  let hashSeq = 0;
  let hashedText: string | null = null;
  let hashedHex: string | null = null;

  async function schemaDigest(text: string): Promise<string | null> {
    if (hashedText === text) return hashedHex;
    const seq = ++hashSeq;
    let hex: string | null = null;
    try {
      hex = await sha256Hex(encoder.encode(text));
    } catch {
      hex = null; // first line carries no terminator, so §7.3 has no boundary to start at
    }
    if (seq !== hashSeq) return hashedHex; // a later edit has already superseded this one
    hashedText = text;
    hashedHex = hex;
    return hex;
  }

  /**
   * §2.2.1's verification half: a consumer holding a pinned reference MUST check the content
   * against the pin before use. `verifyContentHash` is the library's own version and is what
   * `preload` calls after a fetch — this is the same comparison with the digest already in hand,
   * because nothing here is fetched: the demo hands the schema over directly, so the demo is
   * standing in for the fetch that would otherwise trigger it.
   */
  /**
   * `resolveSchema` registers a schema under its own `!!id`, so re-resolving the same text needs a
   * fresh registry rather than the same one twice. Cached by text, so an edit to the *document*
   * never recompiles the schema — which is why the first keystroke costs ~50 ms and the rest ~1 ms.
   */
  let compiled: CompiledSchema | null = null;
  let compiledFor: string | null = null;

  function compileSchema(text: string): { compiled: CompiledSchema | null; error: Error | null } {
    if (compiledFor === text) return { compiled, error: null };
    try {
      const fresh = standardLibrary();
      compiled = fresh.compile(fresh.resolveSchema(text));
      compiledFor = text;
      return { compiled, error: null };
    } catch (error) {
      compiled = null;
      compiledFor = null;
      return { compiled: null, error: error as Error };
    }
  }

  /** A library gap is not a verdict on the document, so it is styled and worded differently. */
  const isGap = (code: string) => code === 'NOT_IMPLEMENTED';

  /**
   * The entries this schema declares itself, as opposed to the ~48 it gets from `!!import`ing
   * core.tn — the useful half of "no entry named X" is what you could have written instead.
   * `origins` records ids without their scheme, so both sides are normalised before comparing.
   *
   * Resolver-materialised entries are dropped: desugaring `tags: [non_empty_text]?` lifts a
   * synthetic `array_non_empty_text_70c48588`, and §8.2 makes those names implementation-chosen
   * and non-normative — offering one as something you could have typed would be a lie. The
   * meta-kernel marks them with a `@synthetic` key annotation, which is what this reads.
   */
  function localEntryNames(linked: CompiledSchema['linked']): string[] {
    const strip = (u: string) => u.replace(/^[a-z]+:\/\//i, '').replace(/\?.*$/, '');
    const home = strip(linked.id);
    const isSynthetic = (name: string) =>
      (linked.keyAnnotations.get(name) ?? []).some((a) => a.name === 'synthetic');
    return [...linked.entries.keys()].filter(
      (n) => strip(linked.origins.get(n) ?? '') === home && !isSynthetic(n),
    );
  }

  /** The two references that pin this schema, kept so the re-pin action rewrites exactly them. */
  let selfRef: string | null = null;
  let pinnedRef: string | null = null;
  let pinDiagCount = 0;

  const short = (hex: string) => `${hex.slice(0, 8)}…${hex.slice(-8)}`;

  /**
   * Stamps the schema's current digest onto both references that name it: the schema's own `!!id`
   * and the document's `!!schema`. §2.2.1's pinning half, via the library's `withSha256Pin`, the
   * exact inverse of the `declaredSha256` read that found the mismatch. Re-pinning the `!!id` is
   * safe mid-flight because §7.3 excludes that line from the hash, so the digest it states stays
   * the digest of what follows. Deliberately an action: a consumer re-pins after reviewing a new
   * version of a schema, and doing it automatically would forge the thing the pin exists to prove.
   */
  function repin() {
    if (!dataEl || !schemaEl || !hashedHex) return;
    if (selfRef) schemaEl.value = schemaEl.value.replace(selfRef, withSha256Pin(selfRef, hashedHex));
    if (pinnedRef) dataEl.value = dataEl.value.replace(pinnedRef, withSha256Pin(pinnedRef, hashedHex));
    void safeRun();
  }

  /** One reference's pin against the digest, or null when it agrees, declares nothing, or is absent. */
  function pinProblem(ref: string | null, digest: string, what: string): Diagnostic | null {
    if (!ref) return null;
    let declared: string | undefined;
    try {
      declared = declaredSha256(ref);
    } catch (e) {
      // A pin that is not full-length lowercase hex is never silently retained.
      return { code: 'SCHEMA_ERROR', message: (e as Error).message };
    }
    if (!declared || declared === digest) return null;
    return {
      code: 'SCHEMA_ERROR',
      message:
        `${what} pins sha256 ${short(declared)}, but the schema's content hashes to ` +
        `${short(digest)} — a consumer MUST NOT use content that does not match its pin (§2.2.1)`,
    };
  }

  /**
   * §2.2.1's verification half, over both ends of the reference: the identity the schema claims for
   * itself, and the identity the document requires of it. `verifyContentHash` is the library's own
   * version and is what `preload` calls after a fetch — this is the same comparison with the digest
   * already in hand, because nothing here is fetched: the demo hands the schema over directly, so
   * it stands in for the fetch that would otherwise trigger the check.
   */
  function checkPins(doc: Document | null, schemaText: string, digest: string | null): Diagnostic[] {
    pinnedRef = doc?.schema ?? null;
    selfRef = null;
    if (!digest) return [];
    try {
      selfRef = classifyDocument(encoder.encode(schemaText)).id ?? null;
    } catch {
      // An unparseable header is already reported by the compile step.
    }
    // Only the *consumer* side is reported. A schema's own `!!id` is pinned at publication, not
    // while it is being written — this repository's own draft `.tn` files spell the digest
    // `xxhash` for exactly that reason — and `resolveSchema` does not verify a schema against its
    // own `!!id` either, so flagging it on every keystroke would be this page inventing a check
    // the implementation does not make. `repin` still updates it, so it is correct once pinned.
    const problem = pinProblem(pinnedRef, digest, 'the document\u2019s !!schema');
    return problem ? [problem] : [];
  }

  /** One synthetic entry in the diagnostics list, for the problems the library reports by throwing. */
  function renderSingleProblem(code: string, message: string) {
    if (!diagsEl) return;
    diagsEl.innerHTML =
      `<li><button type="button"><span class="diag-top"><span class="code gap">${escapeHtml(code)}</span></span>` +
      `<span class="msg">${escapeHtml(message)}</span></button></li>`;
  }

  const positionLabel = (d: Diagnostic) =>
    d.dataPosition ? `${d.dataPosition.line}:${d.dataPosition.column}` : '—';

  function renderGutter(text: string, lines: number[]) {
    const bad = new Set(lines);
    // A document ending in a newline has a trailing empty line that editors do not number.
    const lineCount = text.split('\n').length;
    const count = text.endsWith('\n') ? lineCount - 1 : lineCount;
    const rows: string[] = [];
    for (let n = 1; n <= count; n++) {
      rows.push(bad.has(n) ? `<span class="bad">${n}</span>` : String(n));
    }
    return rows.join('\n');
  }

  const escapeHtml = (s: unknown) =>
    String(s).replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );

  /** A byte offset into the UTF-8 encoding of `text`, as an index into the JS string. */
  function utf16IndexOfByteOffset(text: string, byteOffset: number) {
    let bytes = 0;
    for (let i = 0; i < text.length; ) {
      if (bytes >= byteOffset) return i;
      const cp = text.codePointAt(i)!;
      bytes += cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
      i += cp >= 0x10000 ? 2 : 1;
    }
    return text.length;
  }

  function renderDiagnostics(diagnostics: readonly Diagnostic[]) {
    if (!diagsEl || !dataEl) return;
    if (diagnostics.length === 0) {
      diagsEl.innerHTML = '<li class="empty">Nothing to report — the document conforms.</li>';
      return;
    }
    diagsEl.innerHTML = diagnostics
      .map((d, i) => {
        const detail: string[] = [];
        if (d.path) detail.push(`<span><span class="k">at</span> ${escapeHtml(d.path)}</span>`);
        if (d.expected)
          detail.push(`<span><span class="k">expected</span> ${escapeHtml(d.expected)}</span>`);
        if (d.actual)
          detail.push(`<span><span class="k">found</span> ${escapeHtml(d.actual)}</span>`);
        return `<li><button type="button" data-i="${i}">
        <span class="diag-top">
          <span class="code${isGap(d.code) ? ' gap' : ''}">${escapeHtml(d.code)}</span>
          <span class="at">${positionLabel(d)}</span>
        </span>
        <span class="msg">${escapeHtml(d.message)}</span>
        ${detail.length ? `<span class="detail">${detail.join('')}</span>` : ''}
      </button></li>`;
      })
      .join('');

    // The pin mismatch is the one problem this page can fix for you, so its entry carries the fix.
    if (pinDiagCount > 0) {
      const fix = document.createElement('button');
      fix.type = 'button';
      fix.className = 'fix';
      fix.textContent = 're-pin to the current schema';
      fix.addEventListener('click', repin);
      diagsEl.querySelector('li')?.append(fix);
    }

    // Clicking a diagnostic puts the caret on the offending byte. `offset` is a UTF-8 byte offset
    // and a textarea selection is in UTF-16 units, so it is converted rather than used directly.
    for (const button of diagsEl.querySelectorAll('button')) {
      button.addEventListener('click', () => {
        const d = diagnostics[Number((button as HTMLButtonElement).dataset.i)];
        if (!d?.dataPosition) return;
        const index = utf16IndexOfByteOffset(dataEl.value, d.dataPosition.offset);
        dataEl.focus();
        dataEl.setSelectionRange(index, Math.min(index + 1, dataEl.value.length));
      });
    }
  }

  function setBadge(kind: string, count: number) {
    if (!badgeEl) return;
    badgeEl.textContent = String(count);
    badgeEl.className = `badge ${kind === 'bad' ? 'bad' : kind === 'warn' ? 'warn' : 'ok'}`;
  }

  function setVerdict(kind: string, label: string, count: number, timing: string) {
    if (!verdictEl) return;
    verdictEl.className = `verdict ${kind}`;
    verdictEl.innerHTML =
      `<span class="dot"></span><span><span class="count">${count}</span> ${escapeHtml(label)}</span>` +
      (timing ? `<span class="timing">${timing}</span>` : '');
  }

  async function run() {
    if (!dataEl || !schemaEl || !rootEl || !gutterEl || !diagsEl) return;
    const dataText = dataEl.value;
    const root = rootEl.value.trim();
    const bytes = encoder.encode(dataText);

    schemaBroken = false;
    const digest = await schemaDigest(schemaEl.value);

    // The `!!schema` reference as the document writes it, pin and all. A document that will not
    // parse has worse problems than its pin, so a failure here just skips the check.
    let doc: Document | null = null;
    try {
      doc = parse(bytes).document;
    } catch {
      doc = null;
    }

    const started = performance.now();
    let diagnostics: readonly Diagnostic[];

    if (root === '') {
      // Class 1: base syntax and the built-in type vocabulary, no schema in scope.
      diagnostics = validate(bytes).diagnostics;
    } else {
      const { compiled: schema, error } = compileSchema(schemaEl.value);
      if (error || !schema) {
        setVerdict('warn', 'the schema itself did not compile', 1, '');
        diagsEl.innerHTML =
          `<li><button type="button"><span class="diag-top"><span class="code gap">SCHEMA_ERROR</span></span>` +
          `<span class="msg">${escapeHtml(error?.message ?? 'unknown')}</span></button></li>`;
        gutterEl.textContent = renderGutter(dataText, []);
        setBadge('warn', 1);
        // Never steal the tab here: a schema that will not compile is a schema being edited, and
        // switching away would hide the text under the cursor. The badge carries the signal.
        schemaBroken = true;
        renderNote();
        return;
      }
      // A root naming no entry makes the compiler *throw* rather than report, which would kill
      // this handler and leave the panel showing the previous document's verdict. Checked here so
      // it reads as the ordinary problem it is.
      if (!schema.linked.entries.has(root)) {
        const local = localEntryNames(schema.linked);
        setVerdict('warn', 'no such entry in this schema', 1, '');
        renderSingleProblem(
          'UNKNOWN_ROOT',
          `no entry named '${root}' — this schema declares ${local.length ? local.join(', ') : 'nothing'}`,
        );
        gutterEl.textContent = renderGutter(dataText, []);
        setBadge('warn', 1);
        if (!tabPinned) showTab('diags');
        return;
      }
      diagnostics = validate(bytes, { schema, root }).diagnostics;
      const pins = checkPins(doc, schemaEl.value, digest);
      pinDiagCount = pins.length;
      if (pins.length) diagnostics = [...pins, ...diagnostics];
    }
    const elapsed = performance.now() - started;

    const [verdict, label] =
      diagnostics.length === 0
        ? ['ok', 'diagnostics — the document conforms']
        : diagnostics.every((d) => isGap(d.code))
          ? ['warn', 'library gaps — nothing was checked']
          : [
              'bad',
              diagnostics.length === 1 ? 'diagnostic, in one pass' : 'diagnostics, in one pass',
            ];

    setVerdict(verdict, label, diagnostics.length, `${elapsed.toFixed(1)} ms`);
    renderDiagnostics(diagnostics);
    setBadge(verdict, diagnostics.length);
    // Faults pull the pane over to them; a clean document never pulls it back, so the reader keeps
    // the green verdict they just earned rather than being bounced to the schema.
    if (diagnostics.length > 0 && !tabPinned) showTab('diags');
    gutterEl.innerHTML = renderGutter(
      dataText,
      diagnostics.map((d) => d.dataPosition?.line).filter((n): n is number => Boolean(n)),
    );
  }

  /**
   * Anything the library reports by throwing rather than collecting reaches the panel instead of
   * an uncaught listener, which would leave the last document's verdict on screen as if it still
   * applied. Nothing here should throw; this is so that a gap never looks like a pass.
   */
  async function safeRun() {
    try {
      await run();
    } catch (e) {
      setVerdict('warn', 'the validator itself failed', 1, '');
      renderSingleProblem('INTERNAL_ERROR', (e as Error).message);
      setBadge('warn', 1);
      if (!tabPinned) showTab('diags');
    }
  }

  async function loadScenario(scenario: Scenario) {
    if (!dataEl || !rootEl || !schemaEl) return;

    // An example is written against one schema, so bring that schema in when it is not already
    // the one loaded — otherwise switching from the observatory to an employee document would
    // read it against the wrong schema entirely. Compared on canonical identity, which ignores
    // the pin, so a re-pinned schema still counts as the same schema and edits to it survive
    // switching between examples in the same family. The `valid` chip always restores, which is
    // what makes it the way back from a schema edited into a corner.
    const want = scenario.schema ?? PEOPLE;
    let current: string | null = null;
    try {
      const id = classifyDocument(encoder.encode(schemaEl.value)).id;
      current = id ? canonicalizeIdentity(id) : null;
    } catch {
      current = null; // unparseable header; treat it as not being the schema we want
    }
    if (scenario.resetsSchema || current !== canonicalizeIdentity(want.id)) {
      schemaEl.value = await pinnedSchema(want);
    }

    // Stamp the document's `!!schema` against the schema actually in scope now. Scenarios keep the
    // placeholder rather than a baked-in digest, so loading one after a re-pin cannot drag the
    // original digest back in — an example is written against the schema you are holding.
    const digest = await schemaDigest(schemaEl.value);
    dataEl.value = digest ? scenario.data.replace('__PIN__', digest) : scenario.data;
    rootEl.value = scenario.root;
    for (const chip of document.querySelectorAll('#tson-demo .chip')) {
      chip.setAttribute('aria-pressed', String((chip as HTMLElement).dataset.id === scenario.id));
    }
    // A scenario is a fresh start, so it takes the tab back: the schema on a clean document, and
    // run() will pull it to the diagnostics if there is anything to show.
    tabPinned = false;
    showTab('schema');
    void safeRun();
  }

  async function init() {
    if (!dataEl || !schemaEl || !rootEl || !chipsEl) return;

    // The whole chain starts out correctly pinned: the schema's `!!meta` and `!!import` carry the
    // stdlib's own identities, its `!!id` carries its own digest, and every document's `!!schema`
    // carries the same. Computed once from the schema as shipped and never restamped — the pin
    // belongs to the document, and rewriting it to track an edit would forge what it proves.
    try {
      schemaEl.value = await pinnedSchema(PEOPLE);
    } catch {
      schemaEl.value = buildSchema(PEOPLE, null);
    }

    for (const scenario of SCENARIOS) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = scenario.ok ? 'chip ok' : 'chip';
      chip.dataset.id = scenario.id;
      chip.textContent = scenario.label;
      chip.setAttribute('aria-pressed', 'false');
      if (scenario.aria) chip.setAttribute('aria-label', scenario.aria);
      chip.addEventListener('click', () => void loadScenario(scenario));
      chipsEl.append(chip);
    }

    let timer: ReturnType<typeof setTimeout>;
    const debounced = () => {
      clearTimeout(timer);
      timer = setTimeout(() => void safeRun(), 120);
    };
    dataEl.addEventListener('input', debounced);
    // The gutter is a sibling of the textarea, not part of it, so it has to be told to follow.
    // Documents short enough not to scroll hid this; the observatory does not.
    dataEl.addEventListener('scroll', () => {
      if (gutterEl) gutterEl.scrollTop = dataEl.scrollTop;
    });
    rootEl.addEventListener('input', debounced);
    // Editing the schema pins the tab: the reader is looking at the text they are typing, and a
    // fault in the *data* must not swap the pane out mid-keystroke.
    schemaEl.addEventListener('input', () => {
      tabPinned = true;
      debounced();
    });

    tabSchema?.addEventListener('click', () => {
      tabPinned = true;
      showTab('schema');
    });
    tabDiags?.addEventListener('click', () => {
      tabPinned = true;
      showTab('diags');
    });

    // Opens on the valid document: this is the hero visual, so the first thing above the fold
    // should be idiomatic TSON, as the static panes it replaces were. The chips invite the break.
    await loadScenario(SCENARIOS[0]);
  }

  void init();
</script>
