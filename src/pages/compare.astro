---
import Layout from '../layout/Layout.astro';
import { CURRENT_REVISION } from '../lib/spec';

const part1Url = `/2026/${CURRENT_REVISION}/tson-part1-data`;
const part2Url = `/2026/${CURRENT_REVISION}/tson-part2-schema`;
const coreUrl = `/2026/${CURRENT_REVISION}/m/core.tn`;
const guideUrl = `/2026/${CURRENT_REVISION}/tson-guide`;

const chipClass = 'inline-block font-mono text-xs font-semibold rounded-full px-3 py-1 mb-2 bg-gray-100 text-teal-800 hover:underline';

// ── the systems compared, in column order ────────────────────
const systems = [
  { name: 'TSON', version: `Revision ${CURRENT_REVISION}` },
  { name: 'XML Schema', version: 'XSD 1.1' },
  { name: 'JSON Schema', version: '2020-12' },
  { name: 'Protobuf', version: 'proto3 / editions' },
  { name: 'ASN.1', version: 'X.680 series' },
  { name: 'YAML', version: '1.2 core schema' },
];

// A cell is [level, text]. y = built in, p = partial (an annotation, a convention, an add-on, or
// only part of the feature), n = not provided, i = descriptive (no verdict). Backticks in the
// text render as code.
type Level = 'y' | 'p' | 'n' | 'i';
type Cell = [Level, string];
type Row = { feature: string; cells: Cell[] };
type Section = { id: string; eyebrow: string; title: string; intro: string; chip?: { label: string; href: string }; rows: Row[] };

const sections: Section[] = [
  {
    id: 'types',
    eyebrow: 'Built-in types',
    title: 'Scalar types',
    intro:
      'What each system names for you, before you write a line of your own. TSON\'s atoms live in the core library, each pinned to the RFC that defines it, and each states its value space: equality and ordering are over values, never spellings. The core library is a starting set, not a ceiling: new atom types arrive through meta extensions (below).',
    chip: { label: 'core.tn', href: coreUrl },
    rows: [
      { feature: 'Boolean', cells: [['y', '`boolean`'], ['y', '`boolean`'], ['y', '`boolean`'], ['y', '`bool`'], ['y', '`BOOLEAN`'], ['y', '`bool`']] },
      { feature: 'Arbitrary-precision integer', cells: [['y', '`integer`'], ['y', '`integer`'], ['y', '`integer`'], ['n', '— 64-bit maximum'], ['y', '`INTEGER`'], ['p', '`int`, range left to the implementation']] },
      { feature: 'Fixed-width integers', cells: [['y', '`int8` … `int256`, `uint8` … `uint256`'], ['y', '`byte`, `short`, `int`, `long` and unsigned forms, 8–64 bits'], ['p', 'via `minimum` / `maximum`'], ['y', '`int32`, `int64`, `uint32`, `uint64`, plus `sint` / `fixed` wire variants'], ['p', 'via range constraint, `INTEGER (0..255)`'], ['n', '—']] },
      { feature: 'Sign-restricted integers', cells: [['y', '`positive_integer`, `non_negative_integer`, …'], ['y', '`positiveInteger`, `nonNegativeInteger`, …'], ['p', 'via `minimum`'], ['p', 'unsigned widths only'], ['p', 'via range constraint'], ['n', '—']] },
      { feature: 'Exact decimal', cells: [['y', '`number` — exact, no NaN or infinity'], ['y', '`decimal`'], ['p', '`number`; exactness left to the validator'], ['n', '— a string, or `google.type.Decimal`'], ['p', '`REAL` constrained to base 10'], ['n', '— `float` only']] },
      { feature: 'Rational', cells: [['y', '`rational` — `2/4` and `1/2` are one value'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Complex', cells: [['y', '`complex`, components selectable'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'IEEE 754 floating point', cells: [['y', '`float32`, `float64`'], ['y', '`float`, `double`'], ['n', '— one `number` type'], ['y', '`float`, `double`'], ['p', '`REAL` constrained to base 2'], ['y', '`float`, with `.inf` and `.nan`']] },
      { feature: 'Unicode text', cells: [['y', '`text`'], ['y', '`string`, `token`, `normalizedString`'], ['y', '`string`'], ['y', '`string`'], ['y', '`UTF8String` and a dozen restricted string types'], ['y', '`str`']] },
      { feature: 'Binary', cells: [['y', '`bytes` — the value is octets; the alphabet is a spelling'], ['y', '`base64Binary`, `hexBinary` — two distinct types'], ['p', '`contentEncoding`, an annotation'], ['y', '`bytes`'], ['y', '`OCTET STRING`, `BIT STRING`'], ['p', '`!!binary` (YAML 1.1)']] },
      { feature: 'Date', cells: [['y', '`date`'], ['y', '`date`, plus partials `gYear`, `gYearMonth`, …'], ['p', '`format: date`'], ['p', '`google.type.Date`, a common type'], ['y', '`DATE`'], ['p', '`!!timestamp` (YAML 1.1)']] },
      { feature: 'Time of day', cells: [['y', '`time` — offset mandatory, totally ordered'], ['y', '`time` — offset optional, partially ordered'], ['p', '`format: time`'], ['p', '`google.type.TimeOfDay`, a common type'], ['p', '`TIME-OF-DAY` (local), or `TIME` with settings'], ['n', '—']] },
      { feature: 'Date-time instant', cells: [['y', '`datetime` — offset mandatory'], ['y', '`dateTimeStamp`; `dateTime` has an optional offset'], ['p', '`format: date-time`'], ['y', '`google.protobuf.Timestamp`'], ['y', '`GeneralizedTime`, `UTCTime`'], ['p', '`!!timestamp` (YAML 1.1)']] },
      { feature: 'Local date-time (no offset)', cells: [['n', '— excluded by design: an instant needs its offset'], ['y', '`dateTime` without an offset'], ['n', '— RFC 3339 requires the offset'], ['p', '`google.type.DateTime`, zone optional'], ['y', '`DATE-TIME`'], ['n', '—']] },
      { feature: 'Elapsed duration', cells: [['y', '`duration` — seconds, totally ordered'], ['y', '`dayTimeDuration`'], ['p', '`format: duration`, months and seconds mixed'], ['y', '`google.protobuf.Duration`'], ['y', '`DURATION`, months and seconds mixed'], ['n', '—']] },
      { feature: 'Calendar period', cells: [['y', '`period` — months, totally ordered'], ['y', '`yearMonthDuration`'], ['p', 'inside `format: duration`'], ['n', '—'], ['p', 'inside `DURATION`'], ['n', '—']] },
      { feature: 'UUID', cells: [['y', '`uuid` (RFC 9562)'], ['n', '— via `pattern`'], ['p', '`format: uuid`'], ['n', '— a string or bytes'], ['n', '— `OCTET STRING (SIZE(16))`'], ['n', '—']] },
      { feature: 'URI', cells: [['y', '`uri` (RFC 3986)'], ['y', '`anyURI`'], ['p', '`format: uri`, `iri`, `uri-reference`'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Email address', cells: [['y', '`email` — the dot-atom core of RFC 5322'], ['n', '—'], ['p', '`format: email`, `idn-email`'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'IP addresses', cells: [['y', '`ipv4`, `ipv6`'], ['n', '—'], ['p', '`format: ipv4`, `ipv6`'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Networks and hardware addresses', cells: [['y', '`cidr4`, `cidr6`, `mac`'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Regular expression', cells: [['y', '`regex` — I-Regexp (RFC 9485)'], ['n', '— a facet, not a type'], ['p', '`format: regex`'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Object identifier', cells: [['n', '— not in core; a meta extension can add it'], ['n', '—'], ['n', '—'], ['n', '—'], ['y', '`OBJECT IDENTIFIER`, `RELATIVE-OID`, `OID-IRI`'], ['n', '—']] },
      { feature: 'Adding new built-in types', cells: [['y', 'meta extensions declare new atom constructors, facets included'], ['p', 'implementation-defined primitives (1.1)'], ['p', 'custom `$vocabulary` keywords and `format` values'], ['n', '— new types are messages'], ['n', '— a fixed set of built-in types'], ['p', 'application tags, `!mytype`']] },
    ],
  },
  {
    id: 'structures',
    eyebrow: 'Data structures',
    title: 'Structures and composition',
    intro:
      'How values combine. TSON gives each container its own bracket form, the same in the schema as in the data, and treats a record as closed: a field the schema does not declare is an error, not a pass-through. Any value, field or declaration can also carry annotations: typed metadata that never changes whether a value is valid.',
    chip: { label: '§5.3', href: `${part2Url}#53-type-expressions` },
    rows: [
      { feature: 'Record (named fields)', cells: [['y', '`{ name: text }`'], ['y', '`complexType` with `sequence` / `all`'], ['y', '`object` with `properties`'], ['y', '`message`'], ['y', '`SEQUENCE`, `SET`'], ['p', 'mapping, untyped']] },
      { feature: 'Closed to undeclared fields', cells: [['y', 'closed; extras go to an `@rest` map if declared'], ['y', 'closed unless `xs:any` is declared'], ['n', '— open unless `additionalProperties: false`'], ['n', '— unknown fields are kept and skipped'], ['p', 'closed, or open with an extension marker `...`'], ['n', '—']] },
      { feature: 'Map with typed keys', cells: [['y', '`{K => V}`, any key type'], ['n', '— `key` / `keyref` identity constraints'], ['p', '`additionalProperties` + `propertyNames`; keys are strings'], ['y', '`map<K, V>`, integer or string keys'], ['n', '— `SEQUENCE OF` key/value pairs'], ['y', 'mapping; any node can be a key']] },
      { feature: 'Array', cells: [['y', '`[T]`'], ['y', '`maxOccurs`, list types'], ['y', '`array` with `items`'], ['y', '`repeated`'], ['y', '`SEQUENCE OF`'], ['y', 'sequence']] },
      { feature: 'Size bounds', cells: [['y', '`[T; 1..10]`, and the same on maps'], ['y', '`minOccurs` / `maxOccurs`, length facets'], ['y', '`minItems` / `maxItems`'], ['n', '—'], ['y', '`SIZE (1..10)`'], ['n', '—']] },
      { feature: 'Tuple', cells: [['y', '`[number, number]`'], ['p', '`sequence` of named elements'], ['y', '`prefixItems` with `items: false`'], ['n', '—'], ['p', '`SEQUENCE` of named components'], ['n', '—']] },
      { feature: 'Set (unordered, unique)', cells: [['y', '`set<T>`, uniqueness by value'], ['p', '`xs:unique` identity constraint'], ['p', '`uniqueItems`; order still significant'], ['n', '—'], ['y', '`SET OF`'], ['p', '`!!set` (YAML 1.1)']] },
      { feature: 'Enumeration', cells: [['y', '`!enum [A B C]`'], ['y', '`enumeration` facet'], ['y', '`enum`, `const`'], ['y', '`enum`, open in proto3'], ['y', '`ENUMERATED`'], ['n', '—']] },
      { feature: 'Choice between types', cells: [['y', '`(email | phone)` — tagged only where two variants share a form'], ['p', '`union`, simple types only'], ['p', '`oneOf` / `anyOf` — matched by validation, untagged'], ['n', '— wrap in a `oneof`'], ['p', '`CHOICE` — alternatives are labelled'], ['p', 'node tags']] },
      { feature: 'Labelled alternatives', cells: [['y', 'field groups, `( a: T | b: U )`'], ['y', '`xs:choice`'], ['p', '`oneOf` with `required`'], ['y', '`oneof`'], ['y', '`CHOICE`'], ['n', '—']] },
      { feature: 'Required, optional, default, fixed', cells: [['y', 'five field states: `T`, `T?`, `~ default`, `= fixed`, `T? = fixed`; defaults filled in on read'], ['y', '`minOccurs`, `default`, `fixed`'], ['p', '`required`, `const`; `default` is an annotation'], ['p', '`optional`; defaults are zero values'], ['y', '`OPTIONAL`, `DEFAULT`'], ['n', '—']] },
      { feature: 'Absence', cells: [['y', 'one spelling, `_`; no `null` in the notation'], ['y', '`minOccurs="0"`, and `xsi:nil`'], ['y', 'omission, and `null`'], ['p', 'tracked only for `optional`; zero is otherwise unset'], ['y', '`OPTIONAL`, and `NULL`'], ['y', 'omission, and `null` / `~`']] },
      { feature: 'Recursive types', cells: [['y', 'yes'], ['y', 'yes'], ['y', 'yes, via `$ref`'], ['y', 'yes'], ['y', 'yes'], ['n', '— anchors reuse values, not types']] },
      { feature: 'Composition (inherit, IS-A)', cells: [['y', '`A & B & { … }` — several parents, no diamonds'], ['y', '`extension`, substitution groups; one parent'], ['p', '`allOf` merges constraints; no IS-A'], ['n', '— nest a message instead'], ['p', '`COMPONENTS OF` copies fields'], ['p', '`<<` merge key (YAML 1.1)']] },
      { feature: 'Refinement (narrow, keep IS-A)', cells: [['y', '`T ^ { … }` — tighten, default or fix fields; never adds or removes one'], ['y', '`restriction`'], ['p', '`allOf` plus keywords; no subtype relation'], ['n', '—'], ['y', 'subtype constraints, `WITH COMPONENTS`'], ['n', '—']] },
      { feature: 'Subtraction (remove fields)', cells: [['y', '`A - { password }` — breaks IS-A, keeps lineage'], ['p', '`restriction` can drop optional parts'], ['n', '— copy the schema'], ['n', '—'], ['p', '`WITH COMPONENTS` can mark optional components `ABSENT`'], ['n', '—']] },
      { feature: 'Generics', cells: [['y', 'templates over types and values, `vector<T, N>`'], ['n', '—'], ['p', '`$dynamicRef` approximates'], ['n', '—'], ['y', 'parameterized types (X.683)'], ['n', '—']] },
      { feature: 'Open type (value names its type)', cells: [['y', '`declared`, `extern`, `dynamic` — validated against the named type'], ['y', '`xs:any`, `xsi:type`'], ['p', '`{}` accepts anything, unchecked'], ['y', '`google.protobuf.Any`'], ['y', 'open types, `EMBEDDED PDV`'], ['p', 'tags']] },
      { feature: 'Annotations on data', cells: [['y', '`@name:value` on any value, map key or field; preserved in order'], ['p', 'attributes, where the schema admits them'], ['n', '— JSON has no metadata channel'], ['n', '—'], ['n', '—'], ['p', 'tags and anchors; comments are discarded']] },
      { feature: 'Typed, validated annotations', cells: [['y', 'every annotation is a type, `deprecated => @annotation text`; an unknown one is an error, and `@disjoint`, `@discriminator` and `@rest` are checked at load'], ['p', '`xs:appinfo` and foreign attributes, checked only if declared'], ['p', 'annotation keywords; custom ones via `$vocabulary`, unknown ones ignored'], ['y', 'custom options, typed by extending the `*Options` messages'], ['n', '— comments only'], ['n', '—']] },
    ],
  },
  {
    id: 'constraints',
    eyebrow: 'Constraints',
    title: 'Facets and constraints',
    intro:
      'What a schema can say about a value beyond its type. In TSON a constrained type is a named refinement — `age => !integer ^ { min: 0  max: 150 }` — and it IS-A the type it narrows.',
    chip: { label: '§5.5', href: `${part2Url}#55-constructor-application-and-atom-refinement` },
    rows: [
      { feature: 'Numeric bounds, inclusive and exclusive', cells: [['y', '`min` / `exclusive_min`, `max` / `exclusive_max` — on dates too'], ['y', '`minInclusive` … `maxExclusive`'], ['y', '`minimum` … `exclusiveMaximum`'], ['n', '— the protovalidate add-on'], ['y', 'value ranges, `(0<..<10)`'], ['n', '—']] },
      { feature: 'Multiple of', cells: [['y', '`multiple_of`'], ['n', '—'], ['y', '`multipleOf`'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Decimal digits', cells: [['y', '`total_digits`, `fraction_digits`'], ['y', '`totalDigits`, `fractionDigits`'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Text length', cells: [['y', '`min_length`, `max_length`, `length`'], ['y', '`minLength`, `maxLength`, `length`'], ['y', '`minLength`, `maxLength`'], ['n', '—'], ['y', '`SIZE`'], ['n', '—']] },
      { feature: 'Pattern', cells: [['y', '`pattern` — I-Regexp, portable across engines'], ['y', '`pattern`, XSD\'s own dialect'], ['y', '`pattern`, ECMA-262'], ['n', '—'], ['y', '`PATTERN`, permitted alphabet `FROM`'], ['n', '—']] },
      { feature: 'Temporal precision', cells: [['y', '`precision`, 0–9 fractional digits'], ['p', '`explicitTimezone`, or `pattern`'], ['n', '—'], ['n', '—'], ['p', 'time property settings'], ['n', '—']] },
      { feature: 'Address ranges', cells: [['y', '`within` / `excluding` — an empty range is a schema error'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Cross-field rules', cells: [['p', 'field groups only; conditionals declined by design'], ['y', '`xs:assert` (XPath 2.0), `key` / `keyref`'], ['y', '`if` / `then` / `else`, `dependentRequired`, `dependentSchemas`'], ['n', '— CEL through protovalidate'], ['y', 'table and user-defined constraints'], ['n', '—']] },
      { feature: 'A misspelt constraint', cells: [['y', 'refused at load: `{ minimum: 1 }` names no facet of `integer`'], ['y', 'invalid against the schema for schemas'], ['n', '— `minimun: 1` is ignored and constrains nothing'], ['y', 'a `protoc` error'], ['y', 'a compiler error'], ['i', 'n/a']] },
    ],
  },
  {
    id: 'documents',
    eyebrow: 'Documents',
    title: 'Identity, evolution and encodings',
    intro:
      'How a schema is written, found, trusted and changed. Here the systems differ less in features than in model, so several rows describe rather than score.',
    chip: { label: '§10', href: `${part2Url}#10-schema-resolution-model` },
    rows: [
      { feature: 'Schema written in', cells: [['y', 'TSON — the data\'s own notation'], ['y', 'XML'], ['y', 'JSON'], ['i', 'its own IDL, `.proto`'], ['i', 'its own notation'], ['n', '— no schema language; JSON Schema is used']] },
      { feature: 'Meta-schema that describes itself', cells: [['y', 'the meta-kernel'], ['y', 'the schema for schemas'], ['y', 'the meta-schema'], ['p', '`descriptor.proto`'], ['n', '—'], ['n', '—']] },
      { feature: 'Data names its schema', cells: [['y', '`!!schema`, hash-pinned'], ['p', '`xsi:schemaLocation`, a hint'], ['n', '— by convention only'], ['n', '— except `Any` type URLs'], ['n', '—'], ['n', '—']] },
      { feature: 'Content-hash pinning', cells: [['y', 'SHA-256 on every `!!id`, `!!meta`, `!!import` and `!!schema`'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—'], ['n', '—']] },
      { feature: 'Types in data without a schema', cells: [['y', '`!uuid "…"`, `!ipv4 "…"` — checked with no schema at all'], ['y', '`xsi:type`'], ['n', '—'], ['n', '—'], ['y', 'universal tags in BER and DER'], ['p', 'tags, `!!int`, `!!timestamp`']] },
      { feature: 'Evolution model', cells: [['i', 'immutable: a version is a new hash, so a new required field is safe'], ['i', 'namespaces, versioned by convention'], ['i', '`$id` per version, by convention'], ['i', 'field numbers: never reuse, avoid `required`'], ['i', 'extension markers `...`, version brackets `[[ ]]`'], ['i', '—']] },
      { feature: 'Encodings', cells: [['i', 'TSON text; JSON, compact and binary planned'], ['i', 'XML, EXI'], ['i', 'JSON; YAML in practice'], ['i', 'binary wire, ProtoJSON, text format'], ['i', 'BER, DER, PER, OER, XER, JER'], ['i', 'YAML']] },
      { feature: 'Documentation metadata', cells: [['y', '`@doc`, `@title`, `@examples`, `@deprecated`, `@since`'], ['y', '`xs:documentation`, `xs:appinfo`'], ['y', '`title`, `description`, `examples`, `deprecated`'], ['p', 'comments, `deprecated` option'], ['p', 'comments'], ['n', '—']] },
      { feature: 'Comments', cells: [['n', '— annotations instead, which survive parsing'], ['y', '`<!-- -->`'], ['p', '`$comment`'], ['y', '`//` in `.proto`'], ['y', '`--`'], ['y', '`#`']] },
      { feature: 'Standing', cells: [['i', '2026 working draft; Java and TypeScript implementations'], ['i', 'W3C Recommendation, 2012'], ['i', 'IETF draft series; the widest tooling'], ['i', 'Google, open since 2008; code generation for most languages'], ['i', 'ITU-T and ISO since 1984; telecoms and PKI'], ['i', 'YAML 1.2.2, 2021']] },
