---
import Layout from '../../../layout/Layout.astro';
import RevisionNotice from '../../../components/RevisionNotice.astro';
import { getCollection, render } from 'astro:content';
import {
  CURRENT_REVISION,
  documentPath,
  isCurrentRevision,
  revisionOf,
  revisionPath,
  slugOf,
} from '../../../lib/spec';

export async function getStaticPaths() {
  // Spec documents and change logs share this route: same URL shape, same
  // rendering, differing only in the metadata line under the heading.
  const [specEntries, changelogEntries] = await Promise.all([
    getCollection('spec'),
    getCollection('changelog'),
  ]);
  const entries = [...specEntries, ...changelogEntries];

  // A retained revision's document links across to its counterpart in the
  // current revision, when the current revision still carries that slug.
  const currentSlugs = new Set(
    entries.filter(e => isCurrentRevision(revisionOf(e.id))).map(e => slugOf(e.id)),
  );

  return entries.map(entry => {
    const revision = revisionOf(entry.id);
    const slug = slugOf(entry.id);
    return {
      params: { revision, slug },
      props: {
        entry,
        currentHref: currentSlugs.has(slug)
          ? documentPath(CURRENT_REVISION, slug)
          : undefined,
      },
    };
  });
}

const { entry, currentHref } = Astro.props;
const { title, description } = entry.data;
// Only spec documents carry these; a change log carries `against`/`inputs`.
const { draft, status, part } = entry.data as { draft?: string; status?: string; part?: number };
const against = (entry.data as { against?: string }).against;
const revision = revisionOf(entry.id);
const rawUrl = `/raw/2026/${entry.id}.md`;
const pageTitle = isCurrentRevision(revision) ? title : `${title} (Revision ${revision})`;

const { Content } = await render(entry);
---

<Layout title={pageTitle} description={description} type="article">
  <div class="max-w-3xl mx-auto px-6 py-10">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-8 flex items-center gap-1.5">
      <a href={revisionPath(revision)} class="hover:text-gray-900">Specification</a>
      <span>/</span>
      <span class="text-gray-700">{title}</span>
    </nav>

    <RevisionNotice revision={revision} currentHref={currentHref} />

    <!-- Header -->
    <header class="mb-10">
      {part !== undefined && (
        <p class="text-sm font-mono text-gray-400 mb-2">Part {part} of 2</p>
      )}
      {draft === undefined && (
        <p class="text-sm font-mono text-gray-400 mb-2">Change log</p>
      )}
      <h1 class="text-3xl font-bold leading-tight mb-3">{title}</h1>
      <div class="flex items-center gap-4 text-sm text-gray-500 flex-wrap">
        {draft !== undefined ? (
          <>
            <span>Draft {draft}</span>
            <span>·</span>
            <span>{status}</span>
          </>
        ) : (
          <>
            <span>Revision {revision}</span>
            {against && <><span>·</span><span>Against {against}</span></>}
          </>
        )}
        <span>·</span>
        <a href={rawUrl} class="hover:text-gray-900 font-mono">view raw ↗</a>
      </div>
      {draft === undefined && status && (
        <p class="text-sm text-gray-500 mt-3">{status}</p>
      )}
    </header>

    <!-- Content -->
    <article class="prose prose-gray max-w-none">
      <Content />
    </article>

    <div class="mt-16 pt-8 border-t border-gray-200">
      <a href={revisionPath(revision)} class="text-sm text-gray-500 hover:text-gray-900">← Back to Specification</a>
    </div>

  </div>
</Layout>
